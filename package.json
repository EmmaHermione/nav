{
  "name": "bento-glass-nav",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-build glassmorphism Bento personal navigation with client-side AES-256-GCM vault",
  "scripts": {
    "build:css": "tailwindcss -c ./scripts/tailwind.config.js -i ./scripts/tailwind.input.css -o ./assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -c ./scripts/tailwind.config.js -i ./scripts/tailwind.input.css -o ./assets/css/tailwind.min.css --watch",
    "validate": "node ./scripts/validate-links.js",
    "encrypt": "node ./scripts/encrypt-vault.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
